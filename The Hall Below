public enum MatchPhase { None, Lobby, Cutscene, Playing, Ending }

public class GameFlow : MonoBehaviour
{
    public static GameFlow I;
    public MatchPhase Phase { get; private set; } = MatchPhase.None;
    public GameConfig config;

    void Awake()
    {
        I = this;
        DontDestroyOnLoad(gameObject);
    }

    public void GoToMainMenu() => SceneManager.LoadScene("MainMenu");
    public void GoToLobby()
    {
        Phase = MatchPhase.Lobby;
        SceneManager.LoadScene("Lobby");
    }

    public void StartCutscene()
    {
        Phase = MatchPhase.Cutscene;
        SceneManager.LoadScene("HallsBelow_Map");
        // CutsceneController will signal transition to Playing
    }

    public void BeginMatch()
    {
        Phase = MatchPhase.Playing;
        // Initialize systems post-cutscene
        LightingSystem.I?.Initialize();
        MasterySystem.I?.InitializeSession();
        CoinSpawner.I?.SpawnSessionCoins();
        EnvironmentalStoryManager.I?.Init();
    }

    public void EndMatch(bool escaped, bool truth, bool masteryEnding)
    {
        Phase = MatchPhase.Ending;
        // Save progression
        MasterySystem.I?.CommitSessionProgress(escaped, truth, masteryEnding);
        CloudSaveManager.I?.Flush();
        // Return to lobby or main menu
        GoToMainMenu();
    }
}
