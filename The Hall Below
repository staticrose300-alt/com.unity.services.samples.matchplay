public class MasterySystem : MonoBehaviour
{
    public static MasterySystem I;
    public int Level { get; private set; } = 0;
    int fragmentsFoundThisRun = 0;
    bool reachedDeepSection = false;
    bool observedMonsterBehavior = false;

    void Awake() { I = this; DontDestroyOnLoad(gameObject); }

    public void InitializeSession()
    {
        fragmentsFoundThisRun = 0;
        reachedDeepSection = false;
        observedMonsterBehavior = false;
    }

    public void OnDiscoverFragment()
    {
        fragmentsFoundThisRun++;
        EnvironmentalStoryManager.I.UpdateCluesForLevel(Level);
    }

    public void OnReachDeepSection() { reachedDeepSection = true; }
    public void OnObserveMonster() { observedMonsterBehavior = true; }

    public void OnSurviveFlashback()
    {
        // optional: tally resilience
    }

    public void CommitSessionProgress(bool escaped, bool truth, bool masteryEnding)
    {
        int delta = 0;
        if (fragmentsFoundThisRun > 0) delta += 1;
        if (reachedDeepSection) delta += 1;
        if (observedMonsterBehavior) delta += 1;
        if (truth) delta += 1;
        if (masteryEnding) delta += 2;

        Level = Mathf.Clamp(Level + delta, 0, CloudSaveManager.I.Config.masteryMaxLevel);
        CloudSaveManager.I.SaveMastery(Level);
    }
}
