public enum FlashbackType { VisualGlitch, AudioMemory, RareText }

public class FlashbackSystem : MonoBehaviour
{
    public static FlashbackSystem I;
    public GameConfig config;

    void Awake() { I = this; }

    public void TryTriggerProximityFlashback(Vector3 playerPos, Vector3 monsterPos)
    {
        float d = Vector3.Distance(playerPos, monsterPos);
        if (d <= config.proximityTriggerDist)
        {
            TriggerSharedFlashback(FlashbackType.VisualGlitch);
        }
    }

    public void TriggerSharedFlashback(FlashbackType type)
    {
        string id = type.ToString() + "_" + Random.Range(1000, 9999);
        NetRunner.I.BroadcastFlashback(id);
        ApplyFlashbackToAll(type);
        MasterySystem.I.OnSurviveFlashback(); // progression hook
    }

    public void TriggerPersonalFlashback(NetPlayer player, FlashbackType type)
    {
        ApplyFlashbackToPlayer(player, type);
        MasterySystem.I.OnSurviveFlashback();
    }

    void ApplyFlashbackToAll(FlashbackType type)
    {
        foreach (var p in NetRunner.I.ConnectedPlayers)
            ApplyFlashbackToPlayer(p, type);
    }

    void ApplyFlashbackToPlayer(NetPlayer p, FlashbackType type)
    {
        switch (type)
        {
            case FlashbackType.VisualGlitch:
                p.HUD.PlayOverlay("BloodWalls", Random.Range(0.5f, 2f));
                p.Audio.PlayOneShot("MetalImpactDist");
                break;
            case FlashbackType.AudioMemory:
                p.Audio.PlayOneShot("WhisperCountdown");
                p.Audio.PlayOneShot("BreathingBehind");
                p.Audio.PlayOneShot("RadioStatic");
                break;
            case FlashbackType.RareText:
                p.HUD.TextFlicker("> We shouldn’t have taught it the lights.", 1.5f);
                break;
        }
        // Player remains vulnerable; no pause
    }
}
