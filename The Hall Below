public class ObjectiveController : MonoBehaviour
{
    public void OnEscapeAchieved()
    {
        GameFlow.I.EndMatch(escaped: true, truth: false, masteryEnding: false);
    }

    public void OnTruthFilesFound()
    {
        GameFlow.I.EndMatch(escaped: false, truth: true, masteryEnding: false);
    }

    public void OnSecretEndingTriggered()
    {
        if (MasterySystem.I.Level >= 4)
            GameFlow.I.EndMatch(escaped: false, truth: false, masteryEnding: true);
    }
}
