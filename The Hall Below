using UnityEngine;

public class LightNode : MonoBehaviour
{
    public int NodeId;
    public Light lightComp;
    bool isStable = true;

    public void ResetToStable()
    {
        isStable = true;
        if (lightComp != null) { lightComp.enabled = true; lightComp.intensity = 1f; }
    }

    public void Flicker(float intensity, float seconds)
    {
        isStable = false;
        StartCoroutine(FlickerRoutine(intensity, seconds));
    }

    System.Collections.IEnumerator FlickerRoutine(float intensity, float seconds)
    {
        float t = 0f;
        while (t < seconds)
        {
            lightComp.enabled = !lightComp.enabled;
            lightComp.intensity = Random.Range(0.2f, intensity);
            yield return new WaitForSeconds(Random.Range(0.05f, 0.3f));
            t += Time.deltaTime;
        }
        ResetToStable();
    }

    public void Shutdown(float seconds)
    {
        lightComp.enabled = false;
        Invoke(nameof(ResetToStable), seconds);
    }
}
