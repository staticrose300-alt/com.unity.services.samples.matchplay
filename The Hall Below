public class CutsceneController : MonoBehaviour
{
    public AudioSource audioSrc;
    public AudioClip emergencyHum, metalImpact;
    public CanvasGroup black;
    public TMPro.TextMeshProUGUI caption;

    void Start()
    {
        StartCoroutine(Run());
    }

    System.Collections.IEnumerator Run()
    {
        black.alpha = 1f;
        yield return new WaitForSeconds(0.5f);
        audioSrc.PlayOneShot(emergencyHum);
        // Fade in hallway, flickers
        for (int i = 0; i < 12; i++)
        {
            LightingSystem.I.FlickerNearMonster(MonsterAI.I.transform.position, 6f, 1.0f, 0.3f);
            yield return new WaitForSeconds(0.2f);
        }
        audioSrc.PlayOneShot(metalImpact);
        caption.text = "The halls remember.";
        yield return new WaitForSeconds(1.2f);
        caption.text = "";
        black.alpha = 0f;
        GameFlow.I.BeginMatch();
    }
}
