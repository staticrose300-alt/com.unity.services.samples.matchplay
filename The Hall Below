    public void FlickerNearMonster(Vector3 monsterPos, float radius, float intensity, float seconds)
    {
        foreach (var n in nodes)
        {
            float d = Vector3.Distance(monsterPos, n.transform.position);
            if (d <= radius)
            {
                n.Flicker(intensity, seconds);
                NetSharedLighting.I.SyncFlicker(n.NodeId, intensity, seconds);
            }
        }
    }
