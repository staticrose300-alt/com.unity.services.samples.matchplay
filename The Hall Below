using UnityEngine;

public class HallwayGraph : MonoBehaviour
{
    public static HallwayGraph I;

    [SerializeField] Transform[] corners;
    [SerializeField] Transform[] deadEnds;
    [SerializeField] Transform[] patrolNodes;

    void Awake() { I = this; }

    public Vector3 GetRandomShadowCorner()
    {
        return corners[Random.Range(0, corners.Length)].position;
    }

    public float CornerDepth(Vector3 p)
    {
        // Heuristic: nearest corner distance normalized
        float min = float.MaxValue;
        foreach (var c in corners)
            min = Mathf.Min(min, Vector3.Distance(p, c.position));
        return Mathf.Clamp01(1f / Mathf.Max(min, 0.1f));
    }

    public bool IsDeadEnd(Vector3 p)
    {
        foreach (var d in deadEnds)
            if (Vector3.Distance(p, d.position) < 1.5f) return true;
        return false;
    }

    public bool IsMonsterPatrolNode(Vector3 p)
    {
        foreach (var n in patrolNodes)
            if (Vector3.Distance(p, n.position) < 2f) return true;
        return false;
    }
}
