using UnityEngine;

public class NetPlayer : MonoBehaviour
{
    public PlayerRole Role { get; private set; } = PlayerRole.Survivor;
    public HUDController HUD;
    public AudioSource Audio;
    public float CurrentVoiceLevel; // updated by voice input
    public bool IsRunning;

    public void SetRole(PlayerRole role)
    {
        Role = role;
        ApplyRoleAbilities();
    }

    void ApplyRoleAbilities()
    {
        switch (Role)
        {
            case PlayerRole.Medic:
                // Faster revive logic
                break;
            case PlayerRole.Detective:
                // Reveal hidden symbols (shader toggle / decal layer)
                break;
            case PlayerRole.Watcher:
                // Rare vague alerts (HUD pings)
                InvokeRepeating(nameof(WatcherPing), Random.Range(10f, 20f), Random.Range(18f, 30f));
                break;
            case PlayerRole.Survivor:
                // No special abilities
                break;
        }
    }

    void WatcherPing()
    {
        if (Random.value < 0.35f)
        {
            HUD.TextFlicker("Warning… something nearby.", 1.4f);
        }
    }
}
