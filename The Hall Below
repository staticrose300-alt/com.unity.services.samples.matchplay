public class CoinSpawner : MonoBehaviour
{
    public static CoinSpawner I;
    public GameObject coinPrefab;
    public GameConfig config;

    List<Transform> validNodes = new();
    HashSet<int> usedIndices = new();

    void Awake() { I = this; }

    public void RegisterNodes(List<Transform> nodes) => validNodes = nodes;

    public void SpawnSessionCoins()
    {
        usedIndices.Clear();
        int count = Random.Range(config.coinsMin, config.coinsMax);
        for (int i = 0; i < count; i++)
        {
            int idx = GetRandomValidIndex();
            var pos = validNodes[idx].position;
            if (IsRisky(pos))
            {
                Instantiate(coinPrefab, pos, Quaternion.identity);
            }
            else if (Random.value < 0.35f) // some in safer zones
            {
                Instantiate(coinPrefab, pos, Quaternion.identity);
            }
        }
    }

    int GetRandomValidIndex()
    {
        int idx;
        int attempts = 0;
        do
        {
            idx = Random.Range(0, validNodes.Count);
            attempts++;
        }
        while ((usedIndices.Contains(idx) || NearSpawnOrExit(validNodes[idx].position)) && attempts < 50);
        usedIndices.Add(idx);
        return idx;
    }

    bool NearSpawnOrExit(Vector3 p)
    {
        return SpawnPoints.I.NearSpawn(p) || SpawnPoints.I.NearExit(p);
    }

    bool IsRisky(Vector3 p)
    {
        // Dark corners, dead ends, monster patrol nodes
        float cornerDepth = HallwayGraph.I.CornerDepth(p);
        bool deadEnd = HallwayGraph.I.IsDeadEnd(p);
        bool patrol = HallwayGraph.I.IsMonsterPatrolNode(p);
        float score = 0f;
        if (cornerDepth > 0.7f) score += 0.6f;
        if (deadEnd) score += 0.6f;
        if (patrol) score += 0.5f;
        return score * config.riskyWeight > 0.8f;
    }
}
