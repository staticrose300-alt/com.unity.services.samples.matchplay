public enum MonsterState { Dormant, Stalking, Hunting, Vanish }

public class MonsterAI : MonoBehaviour
{
    public static MonsterAI I;
    public MonsterState State { get; private set; } = MonsterState.Dormant;
    public float hearingRadius = 18f;
    public float huntingDarkRadius = 12f;
    public float speed = 3.2f;

    Transform target;
    float masteryAggressionScale => 0.8f + MasterySystem.I.Level * 0.3f;

    void Awake() { I = this; }

    void Update()
    {
        SensePlayers();
        Act();
    }

    void SensePlayers()
    {
        // Pseudocode: pick loudest or nearest player
        var p = MonsterSenses.FindMostDetectablePlayer(transform.position, hearingRadius, masteryAggressionScale);
        if (p != null) target = p.transform;
    }

    void Act()
    {
        switch (State)
        {
            case MonsterState.Dormant:
                if (target) TransitionTo(MonsterState.Stalking);
                break;
            case MonsterState.Stalking:
                LightingSystem.I.FlickerNearMonster(transform.position, huntingDarkRadius, 1.2f, Random.Range(1.2f, 2.0f));
                MoveTowardsTarget(0.6f * speed);
                if (CanStrike()) TransitionTo(MonsterState.Hunting);
                break;
            case MonsterState.Hunting:
                LightingSystem.I.FlickerNearMonster(transform.position, huntingDarkRadius, 1.5f, Random.Range(1.4f, 2.4f));
                MoveTowardsTarget(speed * masteryAggressionScale);
                if (!target) TransitionTo(MonsterState.Vanish);
                break;
            case MonsterState.Vanish:
                // Relocate, false signals at high mastery
                if (MasterySystem.I.Level >= 3 && Random.value < 0.4f) EnvironmentalStoryManager.I.EmitFalseSignal();
                TeleportToShadow();
                TransitionTo(MonsterState.Dormant);
                break;
        }
    }

    void TransitionTo(MonsterState s)
    {
        State = s;
        NetMonster.I.SyncState(s, transform.position);
    }

    void MoveTowardsTarget(float s)
    {
        if (!target) return;
        Vector3 dir = (target.position - transform.position).normalized;
        transform.position += dir * s * Time.deltaTime;
    }

    bool CanStrike()
    {
        return target && Vector3.Distance(transform.position, target.position) < 2.2f;
    }

    void TeleportToShadow()
    {
        // Choose a far dark hallway node
        transform.position = HallwayGraph.I.GetRandomShadowCorner();
    }
}
using UnityEngine;
using System.Linq;

public static class MonsterSenses
{
    public static NetPlayer FindMostDetectablePlayer(Vector3 monsterPos, float baseRadius, float aggressionScale)
    {
        var players = NetRunner.I.ConnectedPlayers;
        float bestScore = 0f;
        NetPlayer best = null;

        foreach (var p in players)
        {
            float d = Vector3.Distance(monsterPos, p.transform.position);
            if (d > baseRadius) continue;

            // Detection influenced by voice loudness and movement noise, scaled by mastery
            float voice = p.CurrentVoiceLevel; // 0..1
            float moveNoise = p.IsRunning ? 0.7f : 0.25f;
            float score = (1f / Mathf.Max(d, 0.1f)) + (voice * 1.5f) + moveNoise;
            score *= aggressionScale;

            if (score > bestScore) { bestScore = score; best = p; }
        }
        return best;
    }
}
